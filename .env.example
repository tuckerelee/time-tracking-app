# Copy to .env.local and fill in.

# Long random string used to sign the login session cookie (32+ characters).
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Your login password, as a bcrypt hash. Generate with: npm run hash-password -- "your password"
# Wrap the value in single quotes, because bcrypt hashes contain "$".
APP_PASSWORD_HASH=

# Where the SQLite database file lives (created automatically).
DATABASE_PATH=./data/app.db
