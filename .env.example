# Copy to .env.local and fill in.

# Long random string used to sign the login session cookie (32+ characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Your login password, as a hash. Generate with: npm run hash-password -- "your password"
APP_PASSWORD_HASH=

# Database. Leave both unset for local development: data goes in ./data/app.db.
# In production, point these at Turso (Vercel's Turso integration sets
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN for you, which also work).
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=
